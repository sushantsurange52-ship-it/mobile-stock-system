datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String             @id @default(uuid())
  name          String
  email         String             @unique
  passwordHash  String             @map("password_hash")
  role          String             @default("admin")
  createdAt     DateTime           @default(now()) @map("created_at")

  stockTransactions StockTransaction[]

  @@map("users")
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")

  mobiles   Mobile[]

  @@map("suppliers")
}

model Mobile {
  id           String             @id @default(uuid())
  brand        String
  model        String
  variant      String
  color        String
  category     String             @default("Smartphone") // e.g., Smartphone, Feature Phone
  costPrice    Decimal            @map("cost_price") @db.Decimal(10, 2)
  sellingPrice Decimal            @map("selling_price") @db.Decimal(10, 2)
  quantity     Int                @default(0)
  reorderLevel Int                @default(5) @map("reorder_level")
  supplierId   String?            @map("supplier_id")
  imageUrl     String?            @map("image_url")
  createdAt    DateTime           @default(now()) @map("created_at")

  supplier          Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stockTransactions StockTransaction[]
  mobileUnits       MobileUnit[]

  @@map("mobiles")
}

model MobileUnit {
  id        String   @id @default(uuid())
  mobileId  String   @map("mobile_id")
  imei      String   @unique
  status    String   @default("in_stock") // in_stock, sold
  createdAt DateTime @default(now()) @map("created_at")

  mobile Mobile @relation(fields: [mobileId], references: [id], onDelete: Cascade)

  @@map("mobile_units")
}

model StockTransaction {
  id        String   @id @default(uuid())
  mobileId  String   @map("mobile_id")
  type      String   // 'IN' or 'OUT'
  quantity  Int
  note      String?
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  mobile Mobile @relation(fields: [mobileId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("stock_transactions")
}
